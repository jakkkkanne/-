# Where drafts/reports/competitor data are stored (default: ./data)
THREADS_OPS_DATA_DIR=data

# "mock" (default) never calls the real Threads API. Set to "real" only once
# THREADS_ACCESS_TOKEN and THREADS_USER_ID below are configured and you have
# verified the mock pipeline end-to-end.
THREADS_OPS_PUBLISHER=mock

# Meta Threads Graph API credentials (only needed for THREADS_OPS_PUBLISHER=real)
# See https://developers.facebook.com/docs/threads
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# Optional: enables AnthropicDraftGenerator for higher-quality draft copy.
# Falls back to the offline TemplateDraftGenerator if unset.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- mt5_trading: USD/JPY automated trading bot (see README) ---
# Requires a MetaTrader 5 terminal installed and logged into your broker
# account (Windows, or Wine on Linux/Mac).
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Only needed if the terminal isn't already running / on PATH.
MT5_PATH=

MT5_SYMBOL=USDJPY
MT5_TIMEFRAME=M15
MT5_BARS=300
MT5_MAGIC=20260905

# Strategy: EMA crossover confirmed by RSI
MT5_FAST_EMA=20
MT5_SLOW_EMA=50
MT5_RSI_PERIOD=14
MT5_RSI_LONG_MAX=70
MT5_RSI_SHORT_MIN=30
MT5_ATR_PERIOD=14
MT5_SL_ATR_MULT=1.5
MT5_TP_ATR_MULT=3.0

# Risk management
MT5_LOT_MODE=risk
MT5_FIXED_LOT=0.01
MT5_RISK_PERCENT=1.0
MT5_MAX_SPREAD_POINTS=30
MT5_MAX_DAILY_LOSS_PERCENT=3.0

# Runtime
MT5_POLL_SECONDS=60
MT5_LOG_FILE=mt5_trading.log

# SAFETY: never sends real orders unless explicitly set to "true". Validate
# on a demo account first.
MT5_ENABLE_LIVE_TRADING=false
