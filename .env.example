# Where drafts/reports/competitor data are stored (default: ./data)
THREADS_OPS_DATA_DIR=data

# "mock" (default) never calls the real Threads API. Set to "real" only once
# THREADS_ACCESS_TOKEN and THREADS_USER_ID below are configured and you have
# verified the mock pipeline end-to-end.
THREADS_OPS_PUBLISHER=mock

# Meta Threads Graph API credentials (only needed for THREADS_OPS_PUBLISHER=real)
# See https://developers.facebook.com/docs/threads
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# Optional: enables AnthropicDraftGenerator for higher-quality draft copy.
# Falls back to the offline TemplateDraftGenerator if unset.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Finance department: monetization assumptions used to project revenue from
# the strategy department's KPI targets. Tune these to your actual model
# (affiliate payout per engagement, lead value per new follower, etc).
THREADS_OPS_REVENUE_PER_ENGAGEMENT=3.0
THREADS_OPS_REVENUE_PER_FOLLOWER=20.0
THREADS_OPS_FOLLOWER_COUNT=0
THREADS_OPS_COST_PER_DRAFT=0.0

# Research: a competitor post at/above this view count is treated as
# "viral" and its format (post_type) is analyzed for patterns to reproduce.
THREADS_OPS_MIN_VIRAL_VIEWS=10000

# Marketing: official weekly posting cadence (business decision), overrides
# the automatic post_count-based heuristic. Current direction: 6 posts/day.
THREADS_OPS_WEEKLY_POST_TARGET=42

# Rakuten affiliate monetization. RAKUTEN_AFFILIATE_ID is issued by Rakuten
# Affiliate (https://affiliate.rakuten.co.jp/) once your application is
# approved -- without it, generated links fall back to plain (unmonetized)
# Rakuten Ichiba search links. THREADS_OPS_WEEKLY_AFFILIATE_CLICKS /
# RAKUTEN conversion & commission rates are finance-department planning
# assumptions, not measured data.
RAKUTEN_AFFILIATE_ID=
THREADS_OPS_WEEKLY_AFFILIATE_CLICKS=0
THREADS_OPS_RAKUTEN_CONVERSION_RATE=0.03
THREADS_OPS_RAKUTEN_COMMISSION_PER_SALE=300.0
